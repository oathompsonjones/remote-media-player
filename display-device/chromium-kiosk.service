[Unit]
Description=Rugby Club Chromium kiosk playback
After=rugby-display.service graphical-session.target
Requires=rugby-display.service

[Service]
Type=simple
Environment=DISPLAY=:0
Environment=XAUTHORITY=/home/display/.Xauthority
ExecStart=/usr/bin/chromium --kiosk --noerrdialogs --disable-infobars --autoplay-policy=no-user-gesture-required http://127.0.0.1:8787/
Restart=always
RestartSec=5
User=display

[Install]
WantedBy=graphical.target